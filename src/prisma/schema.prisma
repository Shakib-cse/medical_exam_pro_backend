generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ------------------------------------
// ENUMS
// ------------------------------------
enum AccountStatus {
  active
  inactive
  suspended
  pending_verification
}

enum PropertyStatus {
  AVAILABLE
  SOLD
  UNDER_OFFER
}

enum OutdoorSpace {
  NONE
  BALCONY
  GARDEN
  TERRACE
}

enum EnergyLabel {
  A
  B
  C
  D
  E
  F
  G
}

enum LocationType {
  CENTRE
  SEMI_CENTRE
  OUTSIDE_CENTRE
}

enum SubscriptionPlan {
  INVESTOR_FREE
  INVESTOR_BASIC
  INVESTOR_PRO
  INVESTOR_PREMIUM
  AGENT_LISTING
  AGENT_UNLIMITED
  AGENT_PRO
  AGENT_PREMIUM
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  TRIALING
}

// ------------------------------------
// MODELS
// ------------------------------------

model Role {
  id          String   @id @default(uuid())
  name        String   @unique // e.g., 'admin', 'agent', 'client', 'user'
  description String?  @db.Text
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
}

model User {
  id              String        @id @default(uuid())
  email           String        @unique
  username        String?       @unique
  firstName       String
  lastName        String
  displayName     String?
  status          AccountStatus @default(pending_verification)
  password        String
  emailVerifiedAt DateTime?
  bio             String?       @db.Text
  targetExam      String?
  avatarUrl       String?       @db.Text

  // Role Relation
  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  // Relations
  subscriptions   Subscription[]
  calculations    SavedCalculation[]
  properties      Property[]         @relation("PropertyAgent")
  savedProperties Property[]         @relation("SavedProperties")
  matchAlerts     MatchAlert[]
  mockAttempts    MockExamAttempt[]
  bankAttempts    BankAttempt[]

  isDeleted   Boolean   @default(false)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
  deletedAt   DateTime?
}

model Country {
  id        String  @id @default(uuid())
  name      String  @unique
  slug      String  @unique
  continent String?
  isActive  Boolean @default(true)

  properties Property[]
  insights   MarketInsight[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model MarketInsight {
  id                  String  @id @default(uuid())
  countryId           String
  country             Country @relation(fields: [countryId], references: [id], onDelete: Cascade)
  regionName          String
  description         String? @db.Text
  averageYield        Float
  averageAppreciation Float
  availableProperties Int     @default(0)
  vacancyRate         Float?
  indicators          Json    @default("[]") // For things like "High demand", etc.
  image               String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model Property {
  id          String  @id @default(uuid())
  title       String
  description String? @db.Text
  location    String
  region      String?

  countryId String?
  country   Country? @relation(fields: [countryId], references: [id], onDelete: SetNull)

  price        Float
  yield        Float // Expected or actual yield percentage
  appreciation Float // Expected appreciation percentage
  type         String // e.g., Apartment, Studio, Villa, etc.
  image        String? @db.Text
  sqm          Float
  bedrooms     Int     @default(0)

  status       PropertyStatus @default(AVAILABLE)
  outdoorSpace OutdoorSpace   @default(NONE)
  energyLabel  EnergyLabel    @default(C)
  locationType LocationType   @default(CENTRE)
  condition    String         @default("Standard") // e.g., Premium, High-End, Basic

  agentId String?
  agent   User?   @relation(name: "PropertyAgent", fields: [agentId], references: [id], onDelete: SetNull)

  calculations SavedCalculation[]
  savedBy      User[]             @relation("SavedProperties")

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model MatchAlert {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name     String?
  criteria Json
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model NewsletterSubscriber {
  id        String   @id @default(uuid())
  email     String   @unique
  markets   Json     @default("[]")
  topics    Json     @default("[]")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model Subscription {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  planType SubscriptionPlan   @default(INVESTOR_FREE)
  status   SubscriptionStatus @default(TRIALING)

  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  currentPeriodEnd     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model SavedCalculation {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  name        String // E.g., 'Lisbon Apartment Calc'
  inputData   Json // The parameters inputted in the calculator
  resultsData Json // The resulting calculations

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model BlogPost {
  id          String  @id @default(uuid())
  title       String
  slug        String  @unique
  excerpt     String? @db.Text
  content     String  @db.LongText // markdown or HTML text
  author      String // Can be a relation to User or just string
  readTime    String? // E.g., '8 min read'
  category    String // E.g., 'Market Trends'
  country     String? // E.g., 'Portugal'
  imageUrl    String? @db.Text
  isFeatured  Boolean @default(false)
  isPublished Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model MockExam {
  id                   String   @id @default(uuid())
  title                String
  examNumber           Int?
  description          String?  @db.Text
  difficultyBadge      String   @default("MODERATE") // "MODERATE" | "ADVANCED" | "CLINICAL" | "STANDARD"
  difficultyType       String   @default("moderate") // "moderate" | "advanced" | "clinical" | "standard"
  durationMinutes      Int      @default(120) // Total duration: 75 + 45 = 120 mins
  cpsDurationMinutes   Int      @default(75)  // CPS section: 75 mins
  pdDurationMinutes    Int      @default(45)  // PD section: 45 mins
  breakDurationMinutes Int      @default(5)   // 5 minute break between sections
  questionCount        Int      @default(136) // Combined question count
  cpsQuestionCount     Int      @default(86)  // CPS question count
  pdQuestionCount      Int      @default(50)  // PD question count
  category             String   @default("MSRA Mock")
  isActive             Boolean  @default(true)

  questions MockQuestion[]
  attempts  MockExamAttempt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model MockQuestion {
  id             String   @id @default(uuid())
  mockExamId     String
  mockExam       MockExam @relation(fields: [mockExamId], references: [id], onDelete: Cascade)
  section        String   @default("CPS") // "CPS" | "PD"
  questionType   String   @default("SBA") // "SBA" | "EMQ" | "RANKING" | "SELECT_3"
  questionText   String   @db.Text
  vignette       String?  @db.Text
  options        Json     // e.g. ["Option A", "Option B", ...]
  optionsDict    Json?    // e.g. { "A": "...", "B": "..." }
  correctAnswer  Int      @default(0) // 0-indexed (for SBA)
  correctOption  String?  // e.g. "A", "B"
  correctAnswers Json?    // For SELECT_3: ["E", "F", "G"]
  idealOrder     Json?    // For RANKING: ["C", "D", "E", "A", "B"]
  explanation    String?  @db.Text
  references     String?  @db.Text
  themeNumber    Int?
  themeTitle     String?
  cases          Json?    // For EMQ: [{ id, caseNumber, vignette, question, correctOption, explanation }]
  subTopic       String?
  order          Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model MockExamAttempt {
  id                String    @id @default(uuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  mockExamId        String
  mockExam          MockExam  @relation(fields: [mockExamId], references: [id], onDelete: Cascade)
  status            String    @default("IN_PROGRESS") // "IN_PROGRESS" | "COMPLETED"
  scorePercentage   Float?
  totalQuestions    Int
  correctAnswers    Int       @default(0)
  timeTakenSeconds  Int       @default(0)
  userAnswers       Json      @default("{}")
  completedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model QuestionBank {
  id              String   @id @default(uuid())
  title           String
  description     String?  @db.Text
  specialty       String   @default("General Medicine")
  category        String   @default("Clinical Practice")
  type            String   @default("Clinical") // "Clinical" | "SJT"
  difficultyBadge String   @default("MODERATE") // "MODERATE" | "ADVANCED" | "CLINICAL" | "STANDARD"
  difficultyType  String   @default("moderate") // "moderate" | "advanced" | "clinical" | "standard"
  durationMinutes Int      @default(15)
  questionCount   Int      @default(0)
  isActive        Boolean  @default(true)

  questions BankQuestion[]
  attempts  BankAttempt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model BankQuestion {
  id             String       @id @default(uuid())
  questionBankId String
  questionBank   QuestionBank @relation(fields: [questionBankId], references: [id], onDelete: Cascade)
  questionText   String       @db.Text
  options        Json         // e.g. ["Option A", "Option B", "Option C", "Option D"]
  correctAnswer  Int          @default(0) // 0-indexed
  explanation    String?      @db.Text
  subTopic       String?
  order          Int          @default(0)
  questionType   String       @default("SBA") // "SBA" | "EMQ"
  themeNumber    Int?
  cases          Json?        // For EMQ cases: [{ id, caseNumber, vignette, question, correctOption, explanation }]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model BankAttempt {
  id               String       @id @default(uuid())
  userId           String
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionBankId   String
  questionBank     QuestionBank @relation(fields: [questionBankId], references: [id], onDelete: Cascade)
  status           String       @default("IN_PROGRESS") // "IN_PROGRESS" | "COMPLETED"
  scorePercentage  Float?
  totalQuestions   Int
  correctAnswers   Int          @default(0)
  timeTakenSeconds Int          @default(0)
  userAnswers      Json         @default("{}")
  completedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model DashboardContent {
  id        String   @id @default(uuid())
  section   String   @unique // "clinical_topics" | "professional_dilemmas" | "daily_goal"
  title     String?
  content   Json     // Flexible JSON for each section's data structure
  isActive  Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

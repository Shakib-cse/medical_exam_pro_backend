# ──────────────────────────────────────────────────────
# Server
# ──────────────────────────────────────────────────────
PORT=3030
NODE_ENV=development
REQUEST_TIMEOUT=30000

# ──────────────────────────────────────────────────────
# Database (MySQL / MariaDB)
# ──────────────────────────────────────────────────────
DATABASE_URL="mysql://username:password@host:3306/database_name"

# ──────────────────────────────────────────────────────
# Security
# ──────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend.vercel.app
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_EXPIRES_IN=1d
JWT_ISSUER=medical-exam-pro

# ──────────────────────────────────────────────────────
# Default Admin (seed only)
# ──────────────────────────────────────────────────────
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=change-me-immediately

# ──────────────────────────────────────────────────────
# Logging
# ──────────────────────────────────────────────────────
LOG_LEVEL=debug

# ──────────────────────────────────────────────────────
# Email (Google Workspace / Gmail SMTP)
# ──────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=contact@medicalexampro.com
SMTP_PASS=your-google-workspace-app-password
EMAIL_FROM="Medical Exam Pro <contact@medicalexampro.com>"

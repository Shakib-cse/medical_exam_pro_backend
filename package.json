{
    "name": "medical-exam-pro-backend",
    "version": "1.0.0",
    "module": "src/index.ts",
    "type": "module",
    "scripts": {
        "dev": "NODE_ENV=development bun run --watch src/index.ts",
        "build": "prisma generate && bunx esbuild api/index.ts --bundle --platform=node --target=node20 --format=cjs --outfile=api/index.cjs --external:bcrypt --external:ws",
        "start": "NODE_ENV=production node api/index.cjs",
        "type-check": "tsc --noEmit",
        "lint": "eslint src --ext .ts",
        "lint:fix": "eslint src --ext .ts --fix",
        "format": "prettier --write \"src/**/*.ts\"",
        "db:generate": "prisma generate",
        "db:migrate": "prisma migrate dev",
        "db:migrate:prod": "prisma migrate deploy",
        "db:push": "prisma db push",
        "db:reset": "prisma migrate reset",
        "db:seed": "bun run src/prisma/seed.ts",
        "db:studio": "prisma studio",
        "postinstall": "prisma generate && prisma db push"
    },
    "dependencies": {
        "@neondatabase/serverless": "^1.1.0",
        "@prisma/adapter-neon": "^7.9.1",
        "@prisma/client": "^7.8.0",
        "bcrypt": "^6.0.0",
        "compression": "^1.8.1",
        "connect-timeout": "^1.9.1",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.5",
        "date-fns": "^4.1.0",
        "dotenv": "^17.2.3",
        "express": "^5.1.0",
        "express-rate-limit": "^8.0.1",
        "helmet": "^8.1.0",
        "jsonwebtoken": "^9.0.2",
        "nodemailer": "^9.0.5",
        "prisma": "^7.8.0",
        "uuid": "^11.1.0",
        "winston": "^3.17.0",
        "winston-daily-rotate-file": "^5.0.0",
        "ws": "^8.21.1",
        "zod": "^4.1.1"
    },
    "devDependencies": {
        "@types/bcrypt": "^6.0.0",
        "@types/bun": "latest",
        "@types/compression": "^1.8.1",
        "@types/connect-timeout": "^1.9.0",
        "@types/cookie-parser": "^1.4.9",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.3",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^25.0.3",
        "@types/nodemailer": "^8.0.1",
        "@types/ws": "^8.18.1",
        "@vercel/node": "^5.9.8",
        "esbuild": "^0.28.2",
        "typescript": "^5.8.3"
    }
}
